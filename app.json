{
  "expo": {
    "name": "AvoCook",
    "slug": "avocook",
    "scheme": "avocook",
    "version": "5.1.0",
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "da": "./locales/da.json"
    },
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "4",
      "bundleIdentifier": "org.epimac.avocook",
      "appleTeamId": "E5L7NC8M9T",
      "appStoreUrl": "https://apps.apple.com/fr/app/avocook/id6769012665",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Connect AvoCook to your Nextcloud server on the local network.",
        "NSPhotoLibraryUsageDescription": "Choose a photo to illustrate a recipe or read a photographed recipe.",
        "NSPhotoLibraryAddUsageDescription": "Save recipe images to your photo library.",
        "NSCameraUsageDescription": "Photograph a recipe or scan a food barcode.",
        "NSCalendarsUsageDescription": "AvoCook requires calendar access because it shares the same system component as reminders, which are used for your grocery lists.",
        "NSCalendarsFullAccessUsageDescription": "AvoCook requires calendar access because it shares the same system component as reminders, which are used for your grocery lists.",
        "NSRemindersUsageDescription": "AvoCook uses your reminders to export and synchronize your grocery lists.",
        "NSRemindersFullAccessUsageDescription": "AvoCook uses your reminders to export and synchronize your grocery lists.",
        "NSMicrophoneUsageDescription": "Use your voice to change steps or start a timer. Voice commands are optional and audio is processed on your device.",
        "NSSpeechRecognitionUsageDescription": "Voice commands are recognized on your device. Audio is not sent to a server.",
        "NSSupportsLiveActivities": true,
        "NSUserActivityTypes": [
          "com.apple.corespotlightitem"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.avocook.mobile",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=app.avocook.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F3EA"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "buildReactNativeFromSource": true,
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "AvoCook requires calendar access because it shares the same system component as reminders, which are used for your grocery lists.",
          "remindersPermission": "AvoCook uses your reminders to export and synchronize your grocery lists."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "en",
              "de",
              "es",
              "it",
              "da"
            ],
            "android": [
              "fr",
              "en",
              "de",
              "es",
              "it",
              "da"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/logo-transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/logo-dark-transparent.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to illustrate a recipe or read a photographed recipe.",
          "cameraPermission": "Photograph a recipe or scan a food barcode.",
          "microphonePermission": "Use your voice to change steps or start a timer. Voice commands are optional and audio is processed on your device."
        }
      ],
      "expo-share-intent",
      "./tools/plugins/withAndroidNetworkSecurity",
      "./tools/plugins/withAndroidSplitsAndOptimizations",
      "./tools/plugins/withAndroidLint",
      "./tools/plugins/withOptionalCamera",
      "./tools/plugins/withIosBuildNumber",
      "./tools/plugins/withProguardRules",
      "./tools/plugins/withAlternateAppIcons",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Photograph a recipe or scan a food barcode.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications",
      "@bacons/apple-targets",
      "./tools/plugins/withAppIntents"
    ],
    "extra": {
      "eas": {
        "projectId": "71346d2a-c2f5-4f0e-a01e-544bfc1f66ca"
      },
      "shoppingPushRelayUrl": "https://avocook-notifications.77dj74wmzc.workers.dev"
    },
    "owner": "logarex"
  }
}
